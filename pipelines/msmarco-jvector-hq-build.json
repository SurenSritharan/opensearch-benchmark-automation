{
  "description": "Build a high-quality JVector index for msmarco 1M (ef_construction=512, M=64)",
  "engine": "__ENGINE__",
  "no_profiling": true,
  "params": {
    "corpus_size": "1m",
    "target_index_name": "cohere-msmarco-1024-1m-hq"
  },
  "steps": [
    { "dataset": "cohere-msmarco-1024", "scenario": "delete-index" },
    { "dataset": "cohere-msmarco-1024", "scenario": "create-index",     "params": { "hnsw_ef_construction": 512, "hnsw_m": 64 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "bulk-ingest-data", "params": { "target_index_bulk_size": 5000 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "refresh-index" },
    { "dataset": "cohere-msmarco-1024", "scenario": "force-merge" },
    { "dataset": "cohere-msmarco-1024", "scenario": "refresh-index" }
  ]
}
