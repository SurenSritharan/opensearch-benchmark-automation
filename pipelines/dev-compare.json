{
  "description": "Dev build comparison — custom dev build from GHE release asset first, then release baseline. Rebuilds index on each version. Cluster restarts after build for cold-start search. Small node only.",
  "engine": "__ENGINE__",
  "versions": ["3.8.0-dev_pr754-v2", "3.8.0"],
  "node_sizes": ["small"],
  "rebuild_on_version_change": true,
  "restart_after_build": true,
  "stats_interval": 30,
  "parameter_sweeps": [
    { "params": { "corpus_size": "1m"  } },
    { "params": { "corpus_size": "10m" } }
  ],
  "first_run_steps": [
    { "dataset": "cohere-wiki-en-768", "scenario": "create-index", "params": { "refresh_interval": -1, "max_merged_segment": "50gb", "segments_per_tier": 6, "translog_flush_threshold_size": "1gb", "floor_segment": "16mb", "merge_scheduler_max_thread_count": 6, "merge_scheduler_auto_throttle": false } },
    { "dataset": "cohere-wiki-en-768", "scenario": "bulk-ingest-data", "params": { "target_index_bulk_size": 200, "target_index_bulk_indexing_clients": 8 } },
    { "dataset": "cohere-wiki-en-768", "scenario": "force-merge", "params": { "client_timeout": 86400, "target_index_max_num_segments": 1 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "create-index", "params": { "refresh_interval": -1, "max_merged_segment": "50gb", "segments_per_tier": 6, "translog_flush_threshold_size": "1gb", "floor_segment": "16mb", "merge_scheduler_max_thread_count": 6, "merge_scheduler_auto_throttle": false } },
    { "dataset": "cohere-msmarco-1024", "scenario": "bulk-ingest-data", "params": { "target_index_bulk_size": 200, "target_index_bulk_indexing_clients": 8 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "force-merge", "params": { "client_timeout": 86400, "target_index_max_num_segments": 1 } }
  ],
  "steps": [
    { "dataset": "cohere-wiki-en-768", "scenario": "vector-search", "params": { "query_k": 10 } },
    { "dataset": "cohere-wiki-en-768", "scenario": "vector-search", "params": { "query_k": 64 } },
    { "dataset": "cohere-wiki-en-768", "scenario": "vector-search", "params": { "query_k": 100 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "query_k": 10,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "query_k": 64,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "query_k": 100, "hnsw_ef_search": 256 } }
  ]
}
