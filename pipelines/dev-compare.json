{
  "description": "Dev build comparison — 3.8.0 release vs 3.8.0-dev from Fyre. Builds indexes once on 3.8.0, re-ingests on version change for 3.8.0-dev. Small node size only.",
  "engine": "__ENGINE__",
  "versions": ["3.8.0-dev_pr754", "3.8.0"],
  "node_sizes": ["small"],
  "rebuild_on_version_change": true,
  "restart_after_build": true,
  "first_run_steps": [
    { "dataset": "cohere-wiki-en-768",       "scenario": "create-index",     "params": { "corpus_size": "1m",  "refresh_interval": -1, "min_batch_size_for_quantization": 100000, "max_merged_segment": "50gb", "segments_per_tier": 6, "translog_flush_threshold_size": "1gb", "floor_segment": "16mb", "merge_scheduler_max_thread_count": 8, "use_derived_source": false } },
    { "dataset": "cohere-wiki-en-768",       "scenario": "bulk-ingest-data", "params": { "corpus_size": "1m",  "target_index_bulk_size": 200, "target_index_bulk_indexing_clients": 8 } },
    { "dataset": "cohere-wiki-en-768",       "scenario": "force-merge",      "params": { "corpus_size": "1m",  "client_timeout": 28800, "target_index_max_num_segments": 1 } },
    { "dataset": "cohere-msmarco-1024",      "scenario": "create-index",     "params": { "corpus_size": "1m",  "refresh_interval": -1, "min_batch_size_for_quantization": 100000, "max_merged_segment": "50gb", "segments_per_tier": 6, "translog_flush_threshold_size": "1gb", "floor_segment": "16mb", "merge_scheduler_max_thread_count": 8, "use_derived_source": false } },
    { "dataset": "cohere-msmarco-1024",      "scenario": "bulk-ingest-data", "params": { "corpus_size": "1m",  "target_index_bulk_size": 200, "target_index_bulk_indexing_clients": 8 } },
    { "dataset": "cohere-msmarco-1024",      "scenario": "force-merge",      "params": { "corpus_size": "1m",  "client_timeout": 28800, "target_index_max_num_segments": 1 } }
  ],
  "steps": [
    { "dataset": "cohere-wiki-en-768",       "scenario": "vector-search", "params": { "corpus_size": "1m",  "query_k": 10 } },
    { "dataset": "cohere-wiki-en-768",       "scenario": "vector-search", "params": { "corpus_size": "1m",  "query_k": 64 } },
    { "dataset": "cohere-wiki-en-768",       "scenario": "vector-search", "params": { "corpus_size": "1m",  "query_k": 100 } },
    { "dataset": "cohere-msmarco-1024",      "scenario": "vector-search", "params": { "corpus_size": "1m",  "query_k": 10,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024",      "scenario": "vector-search", "params": { "corpus_size": "1m",  "query_k": 64,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024",      "scenario": "vector-search", "params": { "corpus_size": "1m",  "query_k": 100, "hnsw_ef_search": 256 } }
  ]
}
