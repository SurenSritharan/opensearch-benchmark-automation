{
  "description": "Recall comparison — merge to 1 segment vs 10 segments at 5M (wiki + msmarco + parquet, k=100/64/10)",
  "engine": "__ENGINE__",
  "params": { "corpus_size": "5m" },
  "steps": [
    { "dataset": "cohere-wiki-en-768",      "scenario": "delete-index",     "label": "seg1-delete-index" },
    { "dataset": "cohere-wiki-en-768",      "scenario": "create-index",     "label": "seg1-create-index" },
    { "dataset": "cohere-wiki-en-768",      "scenario": "bulk-ingest-data", "label": "seg1-bulk-ingest-data" },
    { "dataset": "cohere-wiki-en-768",      "scenario": "force-merge",      "label": "seg1-force-merge", "params": { "target_index_max_num_segments": 1,  "client_timeout": 28800 } },
    { "dataset": "cohere-wiki-en-768",      "scenario": "vector-search",    "label": "seg1-k100", "params": { "query_k": 100 } },
    { "dataset": "cohere-wiki-en-768",      "scenario": "vector-search",    "label": "seg1-k64",  "params": { "query_k": 64  } },
    { "dataset": "cohere-wiki-en-768",      "scenario": "vector-search",    "label": "seg1-k10",  "params": { "query_k": 10  } },

    { "dataset": "cohere-msmarco-1024",     "scenario": "delete-index",     "label": "seg1-delete-index" },
    { "dataset": "cohere-msmarco-1024",     "scenario": "create-index",     "label": "seg1-create-index" },
    { "dataset": "cohere-msmarco-1024",     "scenario": "bulk-ingest-data", "label": "seg1-bulk-ingest-data", "params": { "target_index_bulk_size": 500 } },
    { "dataset": "cohere-msmarco-1024",     "scenario": "force-merge",      "label": "seg1-force-merge",      "params": { "target_index_max_num_segments": 1,  "client_timeout": 28800 } },
    { "dataset": "cohere-msmarco-1024",     "scenario": "vector-search",    "label": "seg1-k100", "params": { "query_k": 100, "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024",     "scenario": "vector-search",    "label": "seg1-k64",  "params": { "query_k": 64,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024",     "scenario": "vector-search",    "label": "seg1-k10",  "params": { "query_k": 10,  "hnsw_ef_search": 256 } },

    { "dataset": "cohere-wiki-parquet-1024","scenario": "delete-index",     "label": "seg1-delete-index" },
    { "dataset": "cohere-wiki-parquet-1024","scenario": "create-index",     "label": "seg1-create-index" },
    { "dataset": "cohere-wiki-parquet-1024","scenario": "bulk-ingest-data", "label": "seg1-bulk-ingest-data" },
    { "dataset": "cohere-wiki-parquet-1024","scenario": "force-merge",      "label": "seg1-force-merge", "params": { "target_index_max_num_segments": 1,  "client_timeout": 28800 } },
    { "dataset": "cohere-wiki-parquet-1024","scenario": "vector-search",    "label": "seg1-k10",  "params": { "query_k": 10 } },

    { "dataset": "cohere-wiki-en-768",      "scenario": "delete-index",     "label": "seg10-delete-index" },
    { "dataset": "cohere-wiki-en-768",      "scenario": "create-index",     "label": "seg10-create-index" },
    { "dataset": "cohere-wiki-en-768",      "scenario": "bulk-ingest-data", "label": "seg10-bulk-ingest-data" },
    { "dataset": "cohere-wiki-en-768",      "scenario": "force-merge",      "label": "seg10-force-merge", "params": { "target_index_max_num_segments": 10, "client_timeout": 28800 } },
    { "dataset": "cohere-wiki-en-768",      "scenario": "vector-search",    "label": "seg10-k100", "params": { "query_k": 100 } },
    { "dataset": "cohere-wiki-en-768",      "scenario": "vector-search",    "label": "seg10-k64",  "params": { "query_k": 64  } },
    { "dataset": "cohere-wiki-en-768",      "scenario": "vector-search",    "label": "seg10-k10",  "params": { "query_k": 10  } },

    { "dataset": "cohere-msmarco-1024",     "scenario": "delete-index",     "label": "seg10-delete-index" },
    { "dataset": "cohere-msmarco-1024",     "scenario": "create-index",     "label": "seg10-create-index" },
    { "dataset": "cohere-msmarco-1024",     "scenario": "bulk-ingest-data", "label": "seg10-bulk-ingest-data", "params": { "target_index_bulk_size": 500 } },
    { "dataset": "cohere-msmarco-1024",     "scenario": "force-merge",      "label": "seg10-force-merge",      "params": { "target_index_max_num_segments": 10, "client_timeout": 28800 } },
    { "dataset": "cohere-msmarco-1024",     "scenario": "vector-search",    "label": "seg10-k100", "params": { "query_k": 100, "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024",     "scenario": "vector-search",    "label": "seg10-k64",  "params": { "query_k": 64,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024",     "scenario": "vector-search",    "label": "seg10-k10",  "params": { "query_k": 10,  "hnsw_ef_search": 256 } },

    { "dataset": "cohere-wiki-parquet-1024","scenario": "delete-index",     "label": "seg10-delete-index" },
    { "dataset": "cohere-wiki-parquet-1024","scenario": "create-index",     "label": "seg10-create-index" },
    { "dataset": "cohere-wiki-parquet-1024","scenario": "bulk-ingest-data", "label": "seg10-bulk-ingest-data" },
    { "dataset": "cohere-wiki-parquet-1024","scenario": "force-merge",      "label": "seg10-force-merge", "params": { "target_index_max_num_segments": 10, "client_timeout": 28800 } },
    { "dataset": "cohere-wiki-parquet-1024","scenario": "vector-search",    "label": "seg10-k10",  "params": { "query_k": 10 } }
  ]
}
