{
  "description": "Version comparison — build index once on first run, search on all versions and node sizes (wiki + msmarco 1M + 5M + 10M)",
  "engine": "__ENGINE__",
  "versions": ["3.7.0", "3.8.0"],
  "node_sizes": ["small", "medium"],
  "restart_after_build": true,
  "first_run_steps": [
    { "dataset": "cohere-wiki-en-768",  "scenario": "create-index",    "params": { "corpus_size": "1m" } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "bulk-ingest-data", "params": { "corpus_size": "1m" } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "force-merge",      "params": { "corpus_size": "1m",  "client_timeout": 28800, "target_index_max_num_segments": 1 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "create-index",     "params": { "corpus_size": "1m" } },
    { "dataset": "cohere-msmarco-1024", "scenario": "bulk-ingest-data", "params": { "corpus_size": "1m",  "target_index_bulk_size": 500 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "force-merge",      "params": { "corpus_size": "1m",  "client_timeout": 28800, "target_index_max_num_segments": 1 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "create-index",     "params": { "corpus_size": "5m" } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "bulk-ingest-data", "params": { "corpus_size": "5m" } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "force-merge",      "params": { "corpus_size": "5m",  "client_timeout": 28800, "target_index_max_num_segments": 3 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "create-index",     "params": { "corpus_size": "5m", "target_index_primary_shards": 3, "refresh_interval": -1 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "bulk-ingest-data", "params": { "corpus_size": "5m", "target_index_bulk_size": 200, "target_index_bulk_indexing_clients": 4, "min_batch_size_for_quantization": 100000 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "force-merge",      "params": { "corpus_size": "5m",  "client_timeout": 28800, "target_index_max_num_segments": 3 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "create-index",     "params": { "corpus_size": "10m", "target_index_primary_shards": 6 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "bulk-ingest-data", "params": { "corpus_size": "10m" } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "force-merge",      "params": { "corpus_size": "10m", "client_timeout": 28800, "target_index_max_num_segments": 3 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "create-index",     "params": { "corpus_size": "10m", "target_index_primary_shards": 6, "refresh_interval": -1 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "bulk-ingest-data", "params": { "corpus_size": "10m", "target_index_bulk_size": 200, "target_index_bulk_indexing_clients": 4, "min_batch_size_for_quantization": 100000 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "force-merge",      "params": { "corpus_size": "10m", "client_timeout": 28800, "target_index_max_num_segments": 3 } }
  ],
  "steps": [
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "1m",  "query_k": 100 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "1m",  "query_k": 64 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "1m",  "query_k": 10 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "1m",  "query_k": 100, "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "1m",  "query_k": 64,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "1m",  "query_k": 10,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "5m",  "query_k": 100 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "5m",  "query_k": 64 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "5m",  "query_k": 10 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "5m",  "query_k": 100, "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "5m",  "query_k": 64,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "5m",  "query_k": 10,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "10m", "query_k": 100 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "10m", "query_k": 64 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "10m", "query_k": 10 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "10m", "query_k": 100, "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "10m", "query_k": 64,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "10m", "query_k": 10,  "hnsw_ef_search": 256 } }
  ]
}
