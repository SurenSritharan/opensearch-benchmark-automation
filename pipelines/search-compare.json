{
  "description": "Version comparison — search-only wiki + msmarco at 1M and 5M across two OpenSearch versions",
  "engine": "__ENGINE__",
  "node_sizes": ["small", "medium"],
  "redeploy": true,
  "versions": ["3.6.0", "3.7.0"],
  "steps": [
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "1m", "query_k": 100 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "1m", "query_k": 10 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "1m", "query_k": 100, "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "1m", "query_k": 10,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "5m", "query_k": 100 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "vector-search", "params": { "corpus_size": "5m", "query_k": 10 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "5m", "query_k": 100, "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "corpus_size": "5m", "query_k": 10,  "hnsw_ef_search": 256 } }
  ]
