{
  "description": "Concurrent bulk-ingest + search with refresh ACTIVE at a fixed refresh_interval of 3s — 5 runs sweeping replicas 0-4 at 1M, seed 500k. A/B against bulk-ingest-and-search (refresh off).",
  "engine": "__ENGINE__",
  "params": {
    "corpus_size": "1m",
    "seed_num_vectors": 500000,
    "refresh_interval": "3s"
  },
  "parameter_sweeps": [
    { "name": "replicas-0", "params": { "target_index_replica_shards": 0 } },
    { "name": "replicas-1", "params": { "target_index_replica_shards": 1 } },
    { "name": "replicas-2", "params": { "target_index_replica_shards": 2 } },
    { "name": "replicas-3", "params": { "target_index_replica_shards": 3 } },
    { "name": "replicas-4", "params": { "target_index_replica_shards": 4 } }
  ],

  "steps": [
    { "dataset": "cohere-wiki-en-768", "scenario": "delete-index" },
    { "dataset": "cohere-wiki-en-768", "scenario": "create-index", "params": { "max_merged_segment": "50gb", "segments_per_tier": 6, "translog_flush_threshold_size": "1gb", "floor_segment": "16mb", "merge_scheduler_max_thread_count": 2 } },
    { "dataset": "cohere-wiki-en-768", "scenario": "bulk-ingest-and-search", "params": { "query_k": 100, "target_index_num_vectors": 500000, "target_index_offset": 500000 } }
  ]
}
