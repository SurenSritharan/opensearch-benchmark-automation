{
  "description": "Concurrent bulk-ingest + search at 10M, seed 5M, refresh 3s, 1 replica. Concurrent ingest and search both fixed at 8 clients; sweeps seed_bulk_indexing_clients 8/14 to see how CPU, memory and disk respond to seed (write-only) load.",
  "engine": "__ENGINE__",
  "params": {
    "corpus_size": "10m",
    "seed_num_vectors": 5000000,
    "refresh_interval": "3s",
    "target_index_replica_shards": 1,
    "target_index_bulk_indexing_clients": 8,
    "search_clients": 8
  },
  "parameter_sweeps": [
    { "name": "seed-8",  "params": { "seed_bulk_indexing_clients": 8 } },
    { "name": "seed-14", "params": { "seed_bulk_indexing_clients": 14 } }
  ],

  "steps": [
    { "dataset": "cohere-wiki-en-768", "scenario": "delete-index" },
    { "dataset": "cohere-wiki-en-768", "scenario": "create-index", "params": { "max_merged_segment": "50gb", "segments_per_tier": 6, "translog_flush_threshold_size": "1gb", "floor_segment": "16mb", "merge_scheduler_max_thread_count": 2 } },
    { "dataset": "cohere-wiki-en-768", "scenario": "bulk-ingest-and-search", "params": { "query_k": 100, "target_index_num_vectors": 5000000, "target_index_offset": 5000000 } }
  ]
}
