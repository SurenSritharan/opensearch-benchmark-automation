{
  "description": "Concurrent bulk-ingest + search at 1M, seed 500k, refresh 3s, 1 replica. Reads fixed at 8 search clients; sweeps bulk ingest clients 2/5/8/11/13 to see how CPU, memory and disk respond to write load.",
  "engine": "__ENGINE__",
  "params": {
    "corpus_size": "1m",
    "seed_num_vectors": 500000,
    "refresh_interval": "3s",
    "target_index_replica_shards": 1,
    "search_clients": 8
  },
  "parameter_sweeps": [
    { "name": "writes-2",  "params": { "target_index_bulk_indexing_clients": 2 } },
    { "name": "writes-5",  "params": { "target_index_bulk_indexing_clients": 5 } },
    { "name": "writes-8",  "params": { "target_index_bulk_indexing_clients": 8 } },
    { "name": "writes-11", "params": { "target_index_bulk_indexing_clients": 11 } },
    { "name": "writes-13", "params": { "target_index_bulk_indexing_clients": 13 } }
  ],

  "steps": [
    { "dataset": "cohere-wiki-en-768", "scenario": "delete-index" },
    { "dataset": "cohere-wiki-en-768", "scenario": "create-index", "params": { "max_merged_segment": "50gb", "segments_per_tier": 6, "translog_flush_threshold_size": "1gb", "floor_segment": "16mb", "merge_scheduler_max_thread_count": 2 } },
    { "dataset": "cohere-wiki-en-768", "scenario": "bulk-ingest-and-search", "params": { "query_k": 100, "target_index_num_vectors": 500000, "target_index_offset": 500000 } }
  ]
}
