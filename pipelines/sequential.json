{
  "description": "Sequential — wiki-768 at 1M: create, ingest (8 ingest clients), force-merge, then search on an idle index. Sweeps search_clients 4/8/12 (one run each; search step only, index built once).",
  "engine": "__ENGINE__",
  "params": { "corpus_size": "1m" },
  "steps": [
    { "dataset": "cohere-wiki-en-768", "scenario": "delete-index" },
    { "dataset": "cohere-wiki-en-768", "scenario": "create-index" },
    { "dataset": "cohere-wiki-en-768", "scenario": "bulk-ingest-data", "params": { "target_index_bulk_indexing_clients": 8 } },
    { "dataset": "cohere-wiki-en-768", "scenario": "refresh-index" },
    { "dataset": "cohere-wiki-en-768", "scenario": "force-merge" },
    { "dataset": "cohere-wiki-en-768", "scenario": "refresh-index" },
    {
      "dataset": "cohere-wiki-en-768",
      "scenario": "vector-search",
      "params": { "query_k": 100 },
      "parameter_sweeps": [
        { "params": { "search_clients": 4 } },
        { "params": { "search_clients": 8 } },
        { "params": { "search_clients": 12 } }
      ]
    }
  ]
}
