{
  "description": "Full run — wiki + msmarco at 10M (create, ingest, merge, search k=100 + k=10)",
  "engine": "__ENGINE__",
  "node_sizes": ["medium"],
  "parameter_sweeps": [
    { "params": { "corpus_size": "1m"  } },
    { "params": { "corpus_size": "5m" } },
    { "params": { "corpus_size": "10m" } }
  ],
  "steps": [
    { "dataset": "cohere-wiki-en-768",  "scenario": "delete-index" },
    { "dataset": "cohere-wiki-en-768",  "scenario": "create-index" },
    { "dataset": "cohere-wiki-en-768",  "scenario": "bulk-ingest-data" },
    { "dataset": "cohere-wiki-en-768",  "scenario": "force-merge",     "params": { "client_timeout": 28800 } },
    { "dataset": "cohere-wiki-en-768",  "scenario": "refresh-index",   "params": { "client_timeout": 3600 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "delete-index" },
    { "dataset": "cohere-msmarco-1024", "scenario": "create-index" },
    { "dataset": "cohere-msmarco-1024", "scenario": "bulk-ingest-data","params": { "target_index_bulk_size": 5000 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "force-merge",     "params": { "client_timeout": 28800 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "refresh-index",   "params": { "client_timeout": 3600 } }
  ]
}
