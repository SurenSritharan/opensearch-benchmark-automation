    { "dataset": "cohere-wiki-parquet", "scenario": "update-index-settings", "params": { "corpus_size": "1m", "index_settings": { "index": { "knn.advanced.approximate_threshold": 0 } } } },
    { "dataset": "cohere-wiki-parquet", "scenario": "force-merge",      "params": { "corpus_size": "1m" } },
    { "dataset": "cohere-wiki-parquet", "scenario": "refresh-index",    "params": { "corpus_size": "1m" } },
    { "dataset": "cohere-wiki-parquet", "scenario": "vector-search",    "params": { "corpus_size": "1m", "query_k": 10 } },

    { "dataset": "cohere-wiki-parquet", "scenario": "delete-index",     "params": { "corpus_size": "5m" } },
