    { "dataset": "cohere-wiki-parquet", "scenario": "vector-search",    "params": { "corpus_size": "50k", "query_k": 10 } },

    { "dataset": "cohere-wiki-parquet", "scenario": "delete-index",     "params": { "corpus_size": "1m" } },
    { "dataset": "cohere-wiki-parquet", "scenario": "create-index",     "params": { "corpus_size": "1m", "approximate_graph_build_threshold": -1 } },
    { "dataset": "cohere-wiki-parquet", "scenario": "bulk-ingest-data", "params": { "corpus_size": "1m" } },
