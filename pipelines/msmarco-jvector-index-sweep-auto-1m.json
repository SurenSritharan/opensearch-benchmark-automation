{
  "description": "Indexing parameter sweep — 16 ef_construction × m combinations using optimised ingest procedure (replicas=0, no auto-throttle during ingest+merge, then re-enable replicas and refresh), followed by vector search to measure recall trade-off.",
  "engine": "__ENGINE__",
  "no_profiling": true,
  "redeploy": true,
  "delete_pvcs": true,
  "params": {
    "corpus_size": "1m",
    "target_index_bulk_size": 5000
  },
  "parameter_sweeps": [
    { "params": { "hnsw_ef_construction": 32,  "hnsw_m": 8  } },
    { "params": { "hnsw_ef_construction": 32,  "hnsw_m": 16 } },
    { "params": { "hnsw_ef_construction": 32,  "hnsw_m": 32 } },
    { "params": { "hnsw_ef_construction": 32,  "hnsw_m": 64 } },
    { "params": { "hnsw_ef_construction": 64,  "hnsw_m": 8  } },
    { "params": { "hnsw_ef_construction": 64,  "hnsw_m": 16 } },
    { "params": { "hnsw_ef_construction": 64,  "hnsw_m": 32 } },
    { "params": { "hnsw_ef_construction": 64,  "hnsw_m": 64 } },
    { "params": { "hnsw_ef_construction": 128, "hnsw_m": 8  } },
    { "params": { "hnsw_ef_construction": 128, "hnsw_m": 16 } },
    { "params": { "hnsw_ef_construction": 128, "hnsw_m": 32 } },
    { "params": { "hnsw_ef_construction": 128, "hnsw_m": 64 } },
    { "params": { "hnsw_ef_construction": 256, "hnsw_m": 8  } },
    { "params": { "hnsw_ef_construction": 256, "hnsw_m": 16 } },
    { "params": { "hnsw_ef_construction": 256, "hnsw_m": 32 } },
    { "params": { "hnsw_ef_construction": 256, "hnsw_m": 64 } }
  ],
  "steps": [
    { "dataset": "cohere-msmarco-1024", "scenario": "delete-index" },
    { "dataset": "cohere-msmarco-1024", "scenario": "create-index", "params": { "target_index_replica_shards": 0, "merge_scheduler_auto_throttle": false } },
    { "dataset": "cohere-msmarco-1024", "scenario": "bulk-ingest-data" },
    { "dataset": "cohere-msmarco-1024", "scenario": "force-merge" },
    { "dataset": "cohere-msmarco-1024", "scenario": "enable-replicas" },
    { "dataset": "cohere-msmarco-1024", "scenario": "refresh-index" },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "query_k": 10,  "hnsw_ef_search": 256 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "vector-search", "params": { "query_k": 100, "hnsw_ef_search": 256 } }
  ]
}
