{
  "description": "JVector DiskANN min_batch_size_for_quantization sweep — wiki + msmarco ingest only (1M, 5M, 10M). Batch size at 1:20 ratio of total vectors: 1M→50K, 5M→250K, 10M→500K.",
  "engine": "jvector",
  "node_sizes": ["medium"],
  "parameter_sweeps": [
    { "params": { "corpus_size": "1m",  "min_batch_size_for_quantization": 50000  } },
    { "params": { "corpus_size": "5m",  "min_batch_size_for_quantization": 250000 } },
    { "params": { "corpus_size": "10m", "min_batch_size_for_quantization": 500000 } }
  ],
  "steps": [
    { "dataset": "cohere-wiki-en-768",  "scenario": "delete-index" },
    { "dataset": "cohere-wiki-en-768",  "scenario": "create-index" },
    { "dataset": "cohere-wiki-en-768",  "scenario": "bulk-ingest-data" },
    { "dataset": "cohere-wiki-en-768",  "scenario": "force-merge" },
    { "dataset": "cohere-wiki-en-768",  "scenario": "refresh-index" },
    { "dataset": "cohere-msmarco-1024", "scenario": "delete-index" },
    { "dataset": "cohere-msmarco-1024", "scenario": "create-index" },
    { "dataset": "cohere-msmarco-1024", "scenario": "bulk-ingest-data", "params": { "target_index_bulk_size": 5000 } },
    { "dataset": "cohere-msmarco-1024", "scenario": "force-merge" },
    { "dataset": "cohere-msmarco-1024", "scenario": "refresh-index" }
  ]
}
