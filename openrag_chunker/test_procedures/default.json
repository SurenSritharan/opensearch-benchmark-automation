{%- set all_searches = [
  "embedding-space-discovery",
  "api-hybrid-query",
  "agent-hybrid-query",
  "api-search",
  "agent-retrieval",
  "knowledge-search",
  "knowledge-facets",
  "api-search-file-filter",
  "agent-retrieval-file-filter",
  "api-search-score-threshold",
  "api-search-keyword-fallback",
  "baseline-knn-only"
] -%}
{%- set dls_comparison_searches = [
  "api-search",
  "agent-retrieval",
  "knowledge-search",
  "knowledge-facets",
  "api-search-file-filter",
  "agent-retrieval-file-filter"
] -%}
{%- macro search_task(operation, clients=none, name=none) -%}
        {
          {%- if name %}
          "name": "{{ name }}",
          {%- endif %}
          "operation": "{{ operation }}",
          "warmup-iterations": {{ search_warmup_iterations | default(50) }},
          "iterations": {{ search_iterations | default(500) }},
          {%- if target_throughput is defined %}
          "target-throughput": {{ target_throughput | tojson }},
          {%- endif %}
          "clients": {{ clients if clients else (search_clients | default(1)) }}
        }
{%- endmacro -%}
{%- macro index_tasks() -%}
        {
          "operation": {
            "operation-type": "delete-index",
            "index": "openrag-bench-documents"
          }
        },
        {
          "operation": {
            "operation-type": "create-index",
            "index": "openrag-bench-documents"
          }
        },
        {
          "name": "check-cluster-health",
          "operation": {
            "operation-type": "cluster-health",
            "index": "openrag-bench-documents",
            "request-params": {
              "wait_for_status": "{{ cluster_health | default('green') }}",
              "wait_for_no_relocating_shards": "true"
            },
            "retry-until-success": true
          }
        },
        {
          "operation": "index-openrag-chunks",
          "warmup-time-period": {{ bulk_warmup_time_period | default(0) }},
          "clients": {{ bulk_indexing_clients | default(1) }},
          "ignore-response-error-level": "{{ error_level | default('non-fatal') }}"
        },
        {
          "operation": "refresh-after-index"
        },
        {%- if force_merge_max_num_segments is defined %}
        {
          "operation": {
            "operation-type": "force-merge",
            "index": "openrag-bench-documents",
            "max-num-segments": {{ force_merge_max_num_segments | tojson }},
            "request-timeout": 7200
          }
        },
        {%- endif %}
        {
          "operation": "wait-until-merges-finish"
        }
{%- endmacro -%}
    {
      "name": "index-and-search",
      "description": "Ingests the chunk corpus the way OpenRAG writes it, then runs every OpenRAG search operation as the admin user.",
      "default": true,
      "schedule": [
        {{ index_tasks() }},
        {%- for op in all_searches %}
        {{ search_task(op) }}{{ "," if not loop.last }}
        {%- endfor %}
      ]
    },
    {
      "name": "index-and-search-dls",
      "description": "Ingests the corpus, creates the synthetic OpenRAG users, then runs each user-facing search as admin and as DLS-restricted users, back to back.",
      "schedule": [
        {{ index_tasks() }},
        {
          "operation": "setup-dls-users"
        },
        {%- for op in dls_comparison_searches %}
        {{ search_task(op) }},
        {{ search_task(op ~ "-dls") }}{{ "," if not loop.last }}
        {%- endfor %}
      ]
    },
    {
      "name": "search-only",
      "description": "Runs every OpenRAG search operation as admin against an index ingested earlier.",
      "schedule": [
        {%- for op in all_searches %}
        {{ search_task(op) }}{{ "," if not loop.last }}
        {%- endfor %}
      ]
    },
    {
      "name": "search-only-dls",
      "description": "Runs the admin-versus-DLS comparison against an index ingested earlier.",
      "schedule": [
        {
          "operation": "setup-dls-users"
        },
        {%- for op in dls_comparison_searches %}
        {{ search_task(op) }},
        {{ search_task(op ~ "-dls") }}{{ "," if not loop.last }}
        {%- endfor %}
      ]
    },
    {
      "name": "ingest-only",
      "description": "Ingests the chunk corpus the way OpenRAG writes it.",
      "schedule": [
        {{ index_tasks() }}
      ]
    },
    {
      "name": "concurrency-sweep",
      "description": "Runs the two retrieval paths an OpenRAG user triggers at increasing client counts. Set search_auth:dls to sweep DLS users.",
      "schedule": [
        {%- if search_auth | default('admin') == 'dls' %}
        {
          "operation": "setup-dls-users"
        },
        {%- endif %}
        {%- set suffix = "-dls" if search_auth | default('admin') == 'dls' else "" %}
        {%- set sweep = sweep_clients | default([1, 2, 4, 8, 16]) %}
        {%- for clients in sweep %}
        {{ search_task("api-search" ~ suffix, clients, "api-search" ~ suffix ~ "-" ~ clients ~ "-clients") }},
        {{ search_task("agent-retrieval" ~ suffix, clients, "agent-retrieval" ~ suffix ~ "-" ~ clients ~ "-clients") }}{{ "," if not loop.last }}
        {%- endfor %}
      ]
    },
    {
      "name": "ingest-while-searching",
      "description": "Ingests the corpus, then re-ingests it at a fixed rate while both retrieval paths search, as when OpenRAG users chat during uploads or a connector re-sync. Every task runs for ingest_while_searching_period seconds.",
      "schedule": [
        {{ index_tasks() }},
        {
          "parallel": {
            "tasks": [
              {
                "name": "reingest-during-search",
                "operation": "index-openrag-chunks",
                "clients": 1,
                "target-throughput": {{ concurrent_ingest_throughput | default(1) }},
                "time-period": {{ ingest_while_searching_period | default(600) }}
              },
              {
                "name": "api-search-during-ingest",
                "operation": "api-search",
                "clients": {{ search_clients | default(1) }},
                "warmup-time-period": 10,
                "time-period": {{ ingest_while_searching_period | default(600) }}
              },
              {
                "name": "agent-retrieval-during-ingest",
                "operation": "agent-retrieval",
                "clients": {{ search_clients | default(1) }},
                "warmup-time-period": 10,
                "time-period": {{ ingest_while_searching_period | default(600) }}
              }
            ]
          }
        }
      ]
    }
